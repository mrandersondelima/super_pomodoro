{
  "name": "super_pomodoro",
  "private": true,
  "version": "1.0.0",
  "description": "Cronometros sequenciais para alternar entre sentado e em pe.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vue-tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.andersonmorais.superpomodoro",
    "productName": "Super Pomodoro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.39",
    "vue-i18n": "^9.14.5",
    "vuetify": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.101.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.5",
    "wait-on": "^9.1.0"
  }
}
